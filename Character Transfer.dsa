/*
	Transfer morphs & character preset from source to target using precomputed barycentric coordinates

	Steps :
	- Initialization :
		- check installed figures to build the list of available source & target figures
		- load source & target figures in the scene on 'Initialize' button click
		- display available source morphs with filtering options (select, include, exclude)
		- load D-Former weights
		- load relevant barycentric maps & set specific data

	- For each selected morph / controller / character :
		- discriminate between head & body morph based on morph region
		- delete existing morph, as overwrite is not allowed
		- restore & zero all figures
		- put source in target pose
		- apply morph on source figure
		- rescale & translate source to normalize to target & align heads
		- create morphs for main figure & its attachments
		- adjust rigging to shape
		- ERC freeze nodes properties
		- write morph to file
		- unload source morph deltas
		- copy card images to destination folder if desired
		-
	- For each selected controller :
		- restore target figure
		- delete existing controller, as overwrite is not allowed
		- create controller
		- ERC Freeze
		- write controller to file
		- copy card images to destination folder if desired

	- For each character found in all content libraries :
		- open source file & apply transferable items to target
		- write character to file
		- on Windows, always duplicate icons. On other OS, duplicate icons if requested, create symlinks otherwise

	Note : all morphs are processed first, then controllers, then characters
*/

try { (function(){

//========================================= Global variables =========================================

// Constants
const DEBUG = false; // Used for development
const VECTOR_RIGHT = new DzVec3(-1, 1, 1); // Used to flip a vector on the x-axis (left to right)
const EYEBROWS_OFFSET = new DzVec3(0, 0, 0.015); // Used to slightly offset eyebrows from forehead to ensure full visibility

// System
const actionMgr = MainWindow.getActionMgr(); // DzActionMgr
const assetIOMgr = App.getAssetIOMgr(); // DzAssetIOMgr
const assetMgr = App.getAssetMgr(); // DzAssetMgr
const contentMgr = App.getContentMgr(); // DzContentMgr
const helper = new DzSceneHelper();

// 'Character Transfer' content library
const contentLibrary = contentMgr.findBaseDirectory(DzContentMgr.NativeDirs, getScriptFileName()).fullPath; // 'Character Transfer' content library
if (contentLibrary === null) // In case script is executed outside of a content library
{
	ErrorMessage('Character Transfer content library not found. Check your installation');
	return;
}

// GUI
var transferLV; // DzListView
var row1; // DzVGroupBox (its visibility can be toggled)
var executeBtn; // DzButton (its visibility can be toggled)
var srcThumbnail; // DzLabel used to display selected source figure or morph thumbnail

// Store target vertices index used in main morph ([String])
var baryKeys;

// Store eyes & mouth bones
const eyeBones = []; // Target figure eyes bones ([DzNode])
const mouthBones = []; // Figure mouth bones ([DzNode]) for target figures with separate Mouth figure (G9 currently)

// Target skeleton pruning
var boneNames = []; // All target figure bone names
var neck; // Target root neck bone (DzNode)
var headNames = []; // Neck + Head bones name

// Source, target & attachments figures & geometry
var src, tgt, tgtEyes, tgtEyelashes, tgtMouth, tgtTear, tgtEyebrows, srcEyes, srcEyelashes, srcMouth, srcTear, srcEyebrows; // DzSkeleton figures
var srcBase, srcMorphed, tgtBase, tgtMorphed, eyelashesBase, tearBase, eyebrowsBase; // Base & morphed geometries (DzVertexMesh)
var srcName, tgtName; // Cache target & source names, as we use them frequently (String)
var rootTongue; // Mouth root tongue bone (DzNode)

// Source morphs, controllers & character presets
var srcMorphs = []; // Source morphs [DzFloatProperty]
var srcCtrls = []; // Source controllers [DzFloatProperty]
var srcCharacters = []; // Source characters found in Content Libraries

// Splitting variables
var dformPath; // Head split D-Former relative path (String)
const weights = {}; // D-Former weights {vertex index : weight in range [0;1]}
var refVertex = -1; // D-Former reference vertex index (int)
const headVertices = []; // Store D-Former vertices index for filtering morphed vertices in head splits
var isHead; // Whether current morph is a head or body one

// Barycentric maps
var mainMap, eyeSocketsGlobesMap, caruncleMap, eyelashesMap, eyebrowsMap, tearMap;

// Reference vertices pairs for scaling purpose : [[Left, Right], [Top, Bottom], [Front, Back]]
var eyeSocketsRefVertsG8; // G8 target eye sockets
var tearRefVerts; // Target tear
var mouthRefVerts; // Mouth cavity

// Reference vertex indices for scaling purpose : [top, bottom, front]
var eyesVerticesSrc; // Source left eye
var eyesVerticesTgt; // Target left eye

// Other reference vertices
var tgtMouthVerts; // Target mouth upper-front 2 vertices (aperture & above)
var eyesBackVertsG8F; // G8F back of eyes vertices
var eyesBackVertsG8M; // G8M back of eyes vertices

// Stored vertices index
const tgtEyesVerts = new Set(); // Target eyes vertices when source eyes are an attachment (currently G9 as source)
const eyeSocketsVertsG8 = new Set(); // G8 target eye sockets vertices
const tgtJawVerts = new Set(); // G8 target complete mouth vertices from 'Mouth' & 'Teeth' surfaces
const mouthCavityVerts = new Set(); // G9 target mouth cavity vertices

// Pose controller used to put source in target pose
var srcPose;

// Temporarily store target transfered morphs (main & attachments) [DzFloatProperty]
var morphs = [];

//================= Helper Functions ==================

function File2Path(str) { return str.match(/(.*)[\/\\]/)[1]||''; } // Return path with filename and extension stripped

function FullPathChecked(str) { return str.isEmpty() ? '' : contentMgr.getAbsolutePath(DzContentMgr.NativeDirs, str); } // Return full path from relative path if path exists, empty string otherwise

function ToUse(prop) { return helper.isNodeProperty(prop) ? prop : prop.getOwner(); } // Return property to use (morph or controller

function ConvertToTarget(srcPath) { return srcPath.replace(src.getLabel().replace('.1', ''), tgt.getLabel().replace('.1', '')); } // Convert source path to target path ('.1' is for G8.1)

function GetVendorProduct(path) { return [path.split('/').slice(-3, -2).join(), path.split('/').slice(-2, -1).join()]; } // Infer vendor & product names from source file path

function GetMorphPath(vendor, product) { return '%1/%2/Morphs/%3/%4'.arg(contentLibrary).arg(File2Path(tgt.assetUri.filePath.substring(1))).arg(vendor).arg(product); } // Get output morph path

//================= Get available (installed) figures ===================

// All existing figures paths
var installed = {
	'Genesis' : '/People/Genesis/Genesis.duf',
	'Genesis 2 Female' : '/People/Genesis 2 Female/Genesis 2 Base Female.duf',
	'Genesis 2 Male' : '/People/Genesis 2 Male/Genesis 2 Base Male.duf',
	'Genesis 3 Female' : '/People/Genesis 3 Female/Genesis 3 Female.duf',
	'Genesis 3 Male' : '/People/Genesis 3 Male/Genesis 3 Male.duf',
	'Genesis 8 Female' : '/People/Genesis 8 Female/Genesis 8 Basic Female.duf',
	'Genesis 8 Male' : '/People/Genesis 8 Male/Genesis 8 Basic Male.duf',
	'Genesis 8.1 Female' : '/People/Genesis 8 Female/Genesis 8.1 Basic Female.duf',
	'Genesis 8.1 Male' : '/People/Genesis 8 Male/Genesis 8.1 Basic Male.duf',
	'Genesis 9' : '/People/Genesis 9/Genesis 9.duf'
//	'Genesis 9 Anime Feminine' : '/People/Genesis 9 Toon/Genesis 9 Base Anime Feminine.duf', // TODO: investigate later
//	'Genesis 9 Anime Masculine' : '/People/Genesis 9 Toon/Genesis 9 Base Anime Masculine.duf' // TODO: investigate later
};

// Filter out uninstalled figures
installed = Object.keys(installed).reduce(function(r, k)
{
	if (!FullPathChecked(installed[k]).isEmpty())
		r[k] = installed[k];
	return r;
}, {});

const forbiddenTargets = ['Genesis', 'Genesis 2 Female', 'Genesis 2 Male', 'Genesis 3 Female', 'Genesis 3 Male']; // We only support G8, G8.1 & G9 targets

//================== GUI ===================

//============
// Window
//============
const window = new DzBasicDialog; window.caption = 'Character Transfer v1'; window.toolTip = ''; window.width = 300;
window.showHelpButton(false); // Hide "What's This" button
window.showAcceptButton(false);
const layout = new DzBoxLayout(window);

// Main box
const wContainer = new DzVGroupBox(window);
wContainer.flat = true;
window.insertWidget(0, wContainer);

//==================
// Display 2 tabs
//==================
const tabs = new DzTabWidget(wContainer);
//layout.addWidget(tabs);
const tab0 = new DzVGroupBox(tabs); tabs.addTab(tab0, 'Transfer');
const tab1 = new DzVGroupBox(tabs); tabs.addTab(tab1, 'Log Report');

const mainBox = new DzVGroupBox(tab0); mainBox.insideMargin = 0; mainBox.insideSpacing = 0;
window.insertWidget(0, mainBox);

//============
// Grid layout
//============
const gridLayout = new DzGridLayout(tab0);
gridLayout.insideMargin = 0;
gridLayout.spacing = 1;

var aMorphsArray = []; // Source figure Morphs ([DzProperty])
