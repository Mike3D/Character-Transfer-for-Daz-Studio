//============
// Helper functions
//============
function Button(parent, txt = '', tip = '')
{
	const btn = new DzPushButton(parent);
	if (parent === window)
		window.addButton(btn);
	if (txt) btn.text = txt;
	if (tip) btn.toolTip = tip;
	return btn;
}

function CheckBox(parent, txt, checked, tip)
{
	const box = new DzCheckBox(parent);
	box.text = txt;
	box.checked = checked;
	if (tip) box.toolTip = tip;
	return box;
}

function Label(parent, txt, width)
{
	const lab = new DzLabel(parent);
	lab.text = txt;
	if (width) lab.setFixedWidth(width);
	return lab;
}

function VGroupBox(parent, title = '', hide = false)
{
	const box = new DzVGroupBox(parent);
	box.title = title;
	if (hide) box.hide();
	return box;
}

function Slider(parent, layout, row, txt, width, value, sensitivity, asPercent, editable, tip, max=10)
{
	const label = Label(parent, txt, null);
	if (layout)
		layout.addWidget(label, row, 0);

	const wgt = new DzFloatSlider(parent);
	if (layout)
		layout.addWidget(wgt, row, 1);
	wgt.setFixedWidth(width);
	wgt.value = value;
	wgt.min = 0;
	wgt.max = max;
	wgt.clamped = true;
	wgt.sensitivity = sensitivity;
	wgt.displayAsPercent = asPercent;
	wgt.textEditable = editable;
	wgt.toolTip = tip;
	return wgt;
}

//============
// Create figure selector (dropdown)
//============
function FigureDropDown(type, current)
{
	const gb = new DzVGroupBox(tab0); gb.title = type + ' Figure';
	gridLayout.addWidget(gb, 0, type === 'Source' ? 0 : 2); // Left (0) or right (2) slot in the grid layout

	// Dropdown
	const ddn = new DzComboBox(gb);
	ddn.toolTip = type === 'Source' ? 'Select donor figure' : 'Select receiver figure';
	for (const key of Object.keys(installed))
	{
		if (type === 'Target' && forbiddenTargets.includes(key)) // Skip 'forbidden' target
			continue;
		ddn.addItem(key);
	}

	// Thumbnail
	const icon = new DzLabel(gb); icon.alignment = DzWidget.AlignCenter;
	connect(ddn, 'activated', function(idx) { icon.pixmap = new Pixmap(FullPathChecked(installed[ddn.itemText(idx)].replace('duf', 'png'))); }); // Set Source/Target thumbnail when selection changes

	if (type === 'Source')
		srcThumbnail = icon;

	// Set default selection (mostly used for development)
	currentText = ddn.findText(current) >= 0 ? current : ddn.currentText; // If user-defined default selection doesn't exist, use currently selected item in the ComboBox
	ddn.currentText = currentText;
	icon.pixmap = new Pixmap(FullPathChecked(installed[currentText].replace('duf', 'png')));

	return ddn;
}

//============
// 'Source' dropdown
//============
const srcCombo = FigureDropDown('Source', 'Genesis');

//=============
// 'Target' dropdown
//=============
const tgtCombo = FigureDropDown('Target', 'Genesis 9');

//==============
// 'Load Scene Setup' button
//==============
const loadBtn = Button(tab0, 'Initialize', 'Once Source & Target have been selected, load figures into scene (or use existing scene in case of rerun of the script)');
loadBtn.setFixedHeight(135);
gridLayout.addWidget(loadBtn, 0, 1); // Placed between Source & Target icons
connect(loadBtn, 'clicked', LoadScene);

// Load figure into scene, zero it & set Resolution & SubDivision Levels to zero
function LoadFigure(path)
{
	startProgress('Load %1 Figure'.arg(path.split('/').slice(-1).join().slice(0, -4)), 1, true, true); // Steps, cancellable, show time

	try
	{
		const uri = new DzUri(path);
		if (!contentMgr.openUri(uri))
			ErrorMessage('\u2620 %1 not found\nPlease reinstall figure using Daz Install Manager'.arg(path));

		const node = Scene.getPrimarySelection(); // DzSkeleton

		finishProgress();

		return node;
	}

	catch (err) { ErrorMessage('Runtime Error: ' + err.message); }
}

// Create scene setup
function CreateSceneSetup()
{
	if (MessageBox.information('\nCreating Scene Setup.\n\nThis can take up to a minute', 'Creating Scene Setup', 'OK', 'Cancel') === 1) // If cancelled by user
		return;

	// Clear scene
	Scene.clear();

	for (const path of [installed[srcCombo.currentText], installed[tgtCombo.currentText]])
		LoadFigure(path);

	Scene.update();
	return true;
}

// Get current scene or load figures into it
function LoadScene()
{
	// Target must be different from Source
	if (srcCombo.currentText === tgtCombo.currentText)
	{
		ErrorMessage('Target must be different from Source', 'Error : Source = Target');
		return;
	}

	// Check current scene & rebuild if necessary
	try { GetFigures(true); } // Perform sanity check by trying to get all figures in the scene
	catch (e)
	{
		if (!CreateSceneSetup()) // Load source & target figures into new scene
			return;
		GetFigures(); // Get all figures in the scene
	}

	// Show 'Transfer List' block & hidden buttons
	for (const w of [row1, executeBtn])
		w.show();

	// Load pose controller used to put source in target pose
	if (!(srcName.startsWith('Genesis8') && tgtName.startsWith('Genesis8'))) // G8F & G8M are in same pose
		srcPose = helper.findPropertyOnNodeByInternalName(tgtName.replace('_1', '') + 'ClonePose', src);

	// Load specific maps
	LoadMaps();

	// Set D-Former weights (mandatory)
	SetWeights(); // Set D-Former weights {vertex index : weight in range [0;1]} & reference vertex
	if (!weights && ErrorMessage('Failed to find a valid D-Former for target figure', 'No D-Former found', 'Exit') === 0)
		window.close();

	CacheGeometry(); // Store all figures base geometries in variables

	GetNeckAndHeadBones(); // Collect target head & neck bones name for skeleton pruning

	// Get all source morphs & fill Transfer ListView
	GetMorphs(); // Collect all morphs & controllers in Actor & Head regions (fill srcMorphs & srcCtrls arrays)
	srcCharacters = []; // Flush array
	UpdateLV(); // Fill 'Transfer List' ListView

	UpdateCounter();
	processEvents();
}

//===============
// Init 'Transfer List' block
//===============
row1 = new DzVGroupBox(tab0); row1.insideMargin = 0; row1.hide(); // Hidden @ start
gridLayout.addWidget(row1, 1, 0, 3, 3); // Full row

//===============
// 'Excluded Keywords' LineEdit
//===============
const excludeLabel = new DzLabel(row1); excludeLabel.text = 'Excluded Keywords'; // Label
const excludeFilter = new DzLineEdit(row1); excludeFilter.text = 'Cranium,Size,Scale,Width,Length,Neck,Cleidomastoid,Scapula,Adams Apple,NOSE,NECK,LIPS,EYE,CHEEK'; excludeFilter.toolTip = 'As we only want full head/body morphs & controllers, these keywords, separated by a comma, are used to filter out partial morphs. You can add or remove keywords to customize the filter to your needs. These filters are case sensitive';
connect(excludeFilter, 'editingFinished', ExcludeUpdate);

// Update available morphs when exclude filter has been modified
function ExcludeUpdate()
{
	// Store selection before updating morphs
	var labels = []; // Checked labels
	for (const item of transferLV.getItems(DzListView.Checked))
		labels.push(item.text(0));

	// Update morphs list & ListView
	GetMorphs();
	UpdateLV();

	// Restore selection for remaining morphs
	for (const label of labels)
	{
		const item = transferLV.findItem(label, 0);
		if (item)
			item.on = true;
	}

	// Update selection counter
	UpdateCounter();
}

//===============
// 'Search filter'
//===============
const searchFilter = new DzLineEdit(row1); searchFilter.placeholderText = 'Search filter (on Label, insensitive to case)';
connect(searchFilter, 'textChanged', FilterMorphsList)

// Update available morphs when search filter has been modified
function FilterMorphsList(filter)
{
	if (filter.isEmpty()) // Restore full visibility
	{
		for (var i = 0; i < aMorphsArray.length; i++)
			transferLVitems[i].visible = true;
	}
	else // Update show/hide
	{
		var regxString = new RegExp(filter.toLowerCase(), 'm'); // Insensitive case search
		for (var i = 0; i < aMorphsArray.length; i++)
			transferLVitems[i].visible = aMorphsArray[i].getLabel().toLowerCase().match(regxString);
	}
}

//===============
// 'Transfer List'
//===============
const wMorphsListLab0 = new DzLabel(row1);
transferLV = new DzListView(row1);
const items = ['Label', 'Type', 'Path', 'Idx'];

for (var i = 0; i < items.length; i++)
{
	transferLV.addColumn(items[i]);
	transferLV.setColumnWidthMode(i, DzListView.Maximum);
}

transferLV.hideColumn(3); // Hide Idx (used internally to link checked items to morphs array)
connect(transferLV, 'currentChanged', ItemChanged);

 // On item change, update selected/total morphs counter & display morph/controller card image
function ItemChanged(item)
{
	UpdateCounter();
	const pres = aMorphsArray[item.id].getPresentation();
	const icon = pres.iconLarge || pres.iconSmall;
	if (icon !== null)
		srcThumbnail.pixmap = new Pixmap(FullPathChecked(icon));
}

// Update transfer ListView
function UpdateLV()
{
	transferLV.clear();

	for (var i = 0; i < aMorphsArray.length; i++)
	{
		const morph = aMorphsArray[i]; // DzProperty
		transferLVitems[i] = new DzCheckListItem(transferLV, DzCheckListItem.CheckBox, i);
		transferLVitems[i].setText(0, morph.getLabel()); // Label
		transferLVitems[i].setText(1, srcMorphs.includes(morph) ? (morph.getPath().startsWith('/Actor/Head') ? 'Head' : 'Body') : 'Ctrl'); // Type
		transferLVitems[i].setText(2, morph.getPath().slice(1)); // Path with first slash stripped
		transferLVitems[i].setText(3, i); // Idx
		transferLVitems[i].visible = true;
		transferLVitems[i].selectable = true;
	}
	UpdateCounter(); // Update selected/total counter
}

//========================= Global settings & select/deselect row ========================

const row3 = new DzHGroupBox(row1); row3.insideMargin = 1;

//============
// 'Duplicate cards & icons' checkbox
//============
const dupliCards = CheckBox(row3, 'Duplicate Images', false, 'Whether to duplicate source images to target : depends whether you intend to share the morphs (duplication required) or use them for yourself (duplication useless)');

//==================
// 'Compress' checkbox
//==================
const compress = CheckBox(row3, 'Compress Files', true, 'Whether to compress output dsf morph & character files');

//==================
