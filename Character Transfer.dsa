const logBtn = Button(window, 'Show Log', 'Open Studio log file (equivalent to Help > Troobleshooting > View Log File... from menu');
connect(logBtn, 'clicked', function() { trigger_action('DzLogFileAction'); }); // 'Show Log' button

//============
