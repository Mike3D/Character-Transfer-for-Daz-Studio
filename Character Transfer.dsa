}

// Update checked counter
function UpdateCounter()
{
	wMorphsListLab0.text = 'Available Character Morphs & Controllers  (%1 / %2)'.arg(transferLV.getItems(DzListView.Checked).length).arg(transferLV.childCount);
}

//================================== Row 4 - Morph Slider ================================

const row4 = VGroupBox(tab0, 'Morph Slider (for selected morph in the list)', true); // Hidden @ start (enabled when morphs have been created)
gridLayout.addWidget(row4, 4, 0, 1, 3);
const morphSlider = Slider(row4, null, 0, '', 200, 0, 0.1, true, false, '', 1);
connect(morphSlider, 'valueChanged', TestMorph); // Sync morph with slider
connect(morphSlider, 'editEnd', function() { morphSlider.value = 0; }); // Reset on release

// Apply selected morph using slider
function TestMorph(value)
{
	// Get selected checked item
	const item = transferLV.selectedItem();
	if (!item || !item.on)
		return;

	// Apply morph value
	const morph = helper.findPropertyOnNodeByInternalName(ToUse(aMorphsArray[item.text(3)]).name, tgt);
	if (morph)
		morph.setValue(value);
}

//================================= Shared bottom buttons =======================================

//==============
