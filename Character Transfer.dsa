const doCharacters = CheckBox(row3, 'Create Characters', false, 'Whether to transfer character presets found in the Characters folder of source figure');

//==============
// 'Select All' button
//==============
const selectAllBtn = Button(row3, 'Select All', 'Check all morphs');
connect(selectAllBtn, 'clicked', SelectAll);

// Check unchecked items
function SelectAll()
{
